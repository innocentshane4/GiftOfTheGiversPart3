@model List<Donation>

@{
    Layout = "_DashboardLayout";
}

<div class="card-brand p-4">
    @if (Model == null || !Model.Any())
    {
        <p class="text-muted-custom small mb-0">
            You haven't made any donations yet.
            <a asp-controller="Donations" asp-action="Donate">Make your first donation</a>.
        </p>
    }
    else
    {
        <div class="table-responsive-cards">
            <table class="table table-brand">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Reference</th>
                        <th>Amount</th>
                        <th>Currency</th>
                        <th>Type</th>
                        <th>Project</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>@d.DonationDate.ToString("dd MMM yyyy")</td>
                            <td>@d.ReferenceNumber</td>
                            <td>@d.Amount.ToString("N2")</td>
                            <td>@d.Currency</td>
                            <td>@(d.DonationType == DonationType.Recurring ? "Recurring" : "One-time")</td>
                            <td>@(d.ReliefProject?.Name ?? "General Fund")</td>
                            <td>
                                <span class="badge-status badge-status-completed">@d.StatusLabel</span>
                            </td>
                            <td class="d-flex gap-2">
                                <a asp-controller="Donations"
                                   asp-action="Confirmation"
                                   asp-route-id="@d.Id"
                                   class="small btn-link-underline">View</a>

                                @if (d.TaxCertificate != null)
                                {
                                    <a asp-controller="Donations"
                                       asp-action="TaxCertificate"
                                       asp-route-id="@d.Id"
                                       class="small btn-link-underline">Certificate</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>