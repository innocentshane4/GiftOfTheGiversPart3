@model List<Donation>
@{
    Layout = "_DashboardLayout";
}

<div class="card-brand p-4">
    @{
        var certified = Model.Where(d => !d.IsAnonymous).ToList();
    }
    @if (!certified.Any())
    {
        <p class="text-muted-custom small mb-0">No eligible donations yet. Tax certificates are available for non-anonymous donations.</p>
    }
    else
    {
        <div class="table-responsive-cards">
            <table class="table table-brand">
                <thead>
                    <tr><th>Date</th><th>Reference</th><th>Amount</th><th>Currency</th><th>Certificate</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var d in certified)
                    {
                        <tr>
                            <td>@d.DonationDate.ToString("dd MMM yyyy")</td>
                            <td>@d.ReferenceNumber</td>
                            <td>@d.Amount.ToString("N2")</td>
                            <td>@d.Currency</td>
                            <td>@(d.TaxCertificate?.CertificateNumber ?? "Not yet generated")</td>
                            <td><a asp-controller="Donations" asp-action="TaxCertificate" asp-route-id="@d.Id" class="btn btn-brand-blue btn-sm">View Certificate</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
