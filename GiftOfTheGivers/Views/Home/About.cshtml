@{
    ViewData["Title"] = "About Us";
}

<section class="section-py container">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <h1>About Gift of the Givers</h1>
            <p>Gift of the Givers is a humanitarian disaster-relief organisation dedicated to restoring hope and
               rebuilding lives in communities affected by natural disasters, conflict and chronic hardship.
               Since our founding, we have coordinated emergency relief, food security, medical support and
               long-term recovery programmes across the region.</p>
            <div class="row g-3 mt-2">
                <div class="col-6">
                    <div class="p-3 card-brand">
                        <h6 class="mb-1"><i class="bi bi-bullseye" style="color:var(--color-primary-orange);"></i> Our Mission</h6>
                        <p class="small text-muted-custom mb-0">To alleviate suffering by delivering rapid, dignified humanitarian relief wherever it is needed most.</p>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 card-brand">
                        <h6 class="mb-1"><i class="bi bi-eye" style="color:var(--color-primary-orange);"></i> Our Vision</h6>
                        <p class="small text-muted-custom mb-0">A region where every community has the support and resources to recover and thrive after crisis.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <img src="/images/about-humanitarian.jpg" class="img-fluid rounded-4 shadow-sm" alt="Volunteers distributing relief supplies" onerror="this.style.display='none'" />
        </div>
    </div>
</section>

<section class="section-py" style="background-color: var(--color-bg-alt);">
    <div class="container">
        <h2 class="text-center mb-5">Our Values</h2>
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="card-brand p-4 text-center h-100">
                    <div class="icon-circle mx-auto mb-3"><i class="bi bi-heart"></i></div>
                    <h6>Compassion</h6>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card-brand p-4 text-center h-100">
                    <div class="icon-circle mx-auto mb-3"><i class="bi bi-shield-check"></i></div>
                    <h6>Integrity</h6>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card-brand p-4 text-center h-100">
                    <div class="icon-circle mx-auto mb-3"><i class="bi bi-clipboard-check"></i></div>
                    <h6>Accountability</h6>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card-brand p-4 text-center h-100">
                    <div class="icon-circle mx-auto mb-3"><i class="bi bi-hand-thumbs-up"></i></div>
                    <h6>Respect</h6>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FOUNDERS SECTION -->
<section class="section-py container">
    <div class="text-center mb-5">
        <h2>Meet the Founders</h2>
        <p class="text-muted-custom">The team behind Gift of the Givers, united by a shared commitment to humanitarian action.</p>
    </div>
    <div class="row g-4 justify-content-center">
        <div class="col-md-4 col-sm-6">
            <div class="card-brand p-0 text-center overflow-hidden h-100">
                <div style="height:280px; overflow:hidden;">
                    <img src="/images/team/ntando.jpeg"
                         style="width:100%; height:100%; object-fit:cover; object-position:top;"
                         alt="Ntando" />
                </div>
                <div class="p-4">
                    <h5 class="mb-1">Ntando</h5>
                    <p class="small" style="color:var(--color-primary-orange); font-weight:600; margin-bottom:8px;">Co-Founder</p>
                    <p class="small text-muted-custom mb-0">Driven by a passion for community upliftment, Ntando brings strategic vision and operational leadership to the foundation.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card-brand p-0 text-center overflow-hidden h-100">
                <div style="height:280px; overflow:hidden;">
                    <img src="/images/team/njabulo.jpeg"
                         style="width:100%; height:100%; object-fit:cover; object-position:top;"
                         alt="Njabulo" />
                </div>
                <div class="p-4">
                    <h5 class="mb-1">Njabulo</h5>
                    <p class="small" style="color:var(--color-primary-orange); font-weight:600; margin-bottom:8px;">Co-Founder</p>
                    <p class="small text-muted-custom mb-0">Njabulo leads the organisation's technology and donor engagement strategy, ensuring every contribution creates maximum impact.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card-brand p-0 text-center overflow-hidden h-100">
                <div style="height:280px; overflow:hidden;">
                    <img src="/images/team/ayanda.jpeg"
                         style="width:100%; height:100%; object-fit:cover; object-position:top;"
                         alt="Ayanda" />
                </div>
                <div class="p-4">
                    <h5 class="mb-1">Ayanda</h5>
                    <p class="small" style="color:var(--color-primary-orange); font-weight:600; margin-bottom:8px;">Co-Founder</p>
                    <p class="small text-muted-custom mb-0">Ayanda drives field operations and volunteer coordination, connecting communities on the ground with the resources they need.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-py container">
    <h2 class="text-center mb-5">Our Disaster-Response Process</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card-brand p-4 text-center h-100">
                <div class="icon-circle mx-auto mb-3">1</div>
                <h5>Assess</h5>
                <p class="small text-muted-custom">Our teams rapidly assess the scale of need and coordinate with local partners on the ground.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-brand p-4 text-center h-100">
                <div class="icon-circle mx-auto mb-3">2</div>
                <h5>Respond</h5>
                <p class="small text-muted-custom">Emergency supplies, shelter and medical support are deployed to affected communities.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-brand p-4 text-center h-100">
                <div class="icon-circle mx-auto mb-3">3</div>
                <h5>Rebuild</h5>
                <p class="small text-muted-custom">Longer-term recovery programmes help communities rebuild infrastructure and livelihoods.</p>
            </div>
        </div>
    </div>
</section>

<section class="section-py" style="background-color: var(--color-bg-alt);">
    <div class="container">
        <h2 class="text-center mb-5">How Your Donations Help</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card-brand p-4 h-100">
                    <div class="icon-circle mb-3"><i class="bi bi-truck"></i></div>
                    <h6>Emergency Relief</h6>
                    <p class="small text-muted-custom mb-0">Funds go directly toward shelter, water, food and medical supplies for disaster-hit communities.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-brand p-4 h-100">
                    <div class="icon-circle mb-3"><i class="bi bi-person-hearts"></i></div>
                    <h6>Volunteer Contribution</h6>
                    <p class="small text-muted-custom mb-0">Volunteers extend our reach, delivering hands-on support alongside donor funding.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-brand p-4 h-100">
                    <div class="icon-circle mb-3"><i class="bi bi-file-earmark-bar-graph"></i></div>
                    <h6>Transparency &amp; Accountability</h6>
                    <p class="small text-muted-custom mb-0">Every donation is tracked and reported against the project it supports.</p>
                </div>
            </div>
        </div>
    </div>
</section>
