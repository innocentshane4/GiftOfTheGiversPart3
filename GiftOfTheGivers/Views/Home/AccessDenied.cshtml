@{
    ViewData["Title"] = "Access Denied";
}

<div class="container section-py text-center" style="max-width:560px;">
    <div class="icon-circle mx-auto mb-3" style="width:80px;height:80px;font-size:2rem;background-color:#FFE8DA;color:var(--color-orange-hover);">
