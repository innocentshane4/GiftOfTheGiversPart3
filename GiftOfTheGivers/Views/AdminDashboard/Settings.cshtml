@{
    Layout = "_DashboardLayout";
}

<div class="card-brand p-4" style="max-width:640px;">
    <h5 class="mb-3">Platform Settings</h5>
    <p class="text-muted-custom small">
        Organisation-wide settings (branding, notification preferences, integration keys for Azure services)
        will live here in the production build. This prototype focuses on the core relief-management workflow.
    </p>
    <dl class="row small mb-0">
        <dt class="col-5">Environment</dt><dd class="col-7">Prototype (local SQLite)</dd>
        <dt class="col-5">Planned Database</dt><dd class="col-7">Azure SQL Database</dd>
        <dt class="col-5">Planned Hosting</dt><dd class="col-7">Microsoft Azure</dd>
        <dt class="col-5">Planned CI/CD</dt><dd class="col-7">Azure Pipelines</dd>
    </dl>
</div>
