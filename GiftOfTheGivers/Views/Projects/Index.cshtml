@model ProjectListViewModel
@{
    ViewData["Title"] = "Relief Projects";
}

<section class="container section-py">
    <div class="text-center mb-4">
        <h1>Relief Projects</h1>
        <p class="text-muted-custom">Browse our active, upcoming and completed humanitarian relief projects.</p>
    </div>

    <form method="get" asp-controller="Projects" asp-action="Index" class="card-brand p-3 mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small mb-1">Search</label>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, location or description" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Status</label>
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<ProjectStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Category</label>
                <select name="category" class="form-select" asp-items="Html.GetEnumSelectList<ProjectCategory>()">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-brand-primary"><i class="bi bi-search"></i></button>
            </div>
        </div>
    </form>

    @if (!Model.Projects.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inboxes" style="font-size:2rem;color:var(--color-text-muted);"></i>
            <p class="text-muted-custom mt-2">No relief projects match your search.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var project in Model.Projects)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card-brand h-100 d-flex flex-column">
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge-status badge-status-@project.Status.ToString().ToLower()">@project.StatusLabel</span>
                                <span class="text-muted-custom small">@project.CategoryLabel</span>
                            </div>
                            <h5>@project.Name</h5>
                            <p class="text-muted-custom small mb-1"><i class="bi bi-geo-alt"></i> @project.Location</p>
                            <p class="text-muted-custom small mb-2">
                                <i class="bi bi-calendar3"></i> @project.StartDate.ToString("MMM yyyy") &rarr; @project.ExpectedCompletionDate.ToString("MMM yyyy")
                            </p>
                            <p class="small flex-grow-1">@(project.Description.Length > 110 ? project.Description.Substring(0, 110) + "…" : project.Description)</p>

                            <div class="mb-2">
                                <div class="d-flex justify-content-between small text-muted-custom mb-1">
                                    <span>Progress</span><span>@project.ProgressPercentage%</span>
                                </div>
                                <div class="progress progress-brand">
                                    <div class="progress-bar" role="progressbar" style="width:@project.ProgressPercentage%"></div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-2">
                                <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" class="btn btn-brand-blue btn-sm flex-grow-1">View Details</a>
                                <a asp-controller="Donations" asp-action="Donate" asp-route-projectId="@project.Id" class="btn btn-brand-primary btn-sm flex-grow-1">Donate</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
