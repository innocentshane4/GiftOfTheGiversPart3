@model ReliefProject
@{
    ViewData["Title"] = Model.Name;
}

<section class="container section-py">
    <a asp-controller="Projects" asp-action="Index" class="small"><i class="bi bi-arrow-left"></i> Back to Relief Projects</a>

    <div class="row mt-3 g-5">
        <div class="col-lg-8">
            <span class="badge-status badge-status-@Model.Status.ToString().ToLower()">@Model.StatusLabel</span>
            <span class="text-muted-custom small ms-2">@Model.CategoryLabel</span>
            <h1 class="mt-2">@Model.Name</h1>
            <p class="text-muted-custom"><i class="bi bi-geo-alt"></i> @Model.Location</p>

            <h5 class="mt-4">Project Overview</h5>
            <p>@Model.Description</p>

            <h5 class="mt-4">Relief Activities</h5>
            <ul class="list-unstyled">
                <li class="mb-2"><i class="bi bi-check-circle-fill" style="color:var(--color-success-green);"></i> On-the-ground needs assessment with local partners</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill" style="color:var(--color-success-green);"></i> Distribution of relief supplies to affected households</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill" style="color:var(--color-success-green);"></i> Coordination with volunteers and field staff</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill" style="color:var(--color-success-green);"></i> Ongoing monitoring and community feedback</li>
            </ul>

            <h5 class="mt-4">Project Updates</h5>
            @if (!Model.Updates.Any())
            {
                <p class="text-muted-custom small">No updates have been posted for this project yet.</p>
            }
            else
            {
                <div class="mt-3">
                    @foreach (var update in Model.Updates)
                    {
                        <div class="timeline-item">
                            <div class="d-flex justify-content-between flex-wrap">
                                <h6 class="mb-1">@update.Title</h6>
                                <span class="text-muted-custom small">@update.PostedDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <p class="small mb-1">@update.Description</p>
                            <p class="text-muted-custom small mb-0">Posted by @(update.Employee?.User?.FullName ?? "Gift of the Givers Team")</p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card-brand p-4">
                <div class="mb-3">
                    <div class="d-flex justify-content-between small text-muted-custom mb-1">
                        <span>Progress</span><span>@Model.ProgressPercentage%</span>
                    </div>
                    <div class="progress progress-brand">
                        <div class="progress-bar" role="progressbar" style="width:@Model.ProgressPercentage%"></div>
                    </div>
                </div>
                <dl class="row small mb-0">
                    <dt class="col-6">Start Date</dt><dd class="col-6">@Model.StartDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-6">Expected Completion</dt><dd class="col-6">@Model.ExpectedCompletionDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-6">Project Budget</dt><dd class="col-6">R@Model.Budget.ToString("N0")</dd>
                    <dt class="col-6">Status</dt><dd class="col-6">@Model.StatusLabel</dd>
                </dl>
                <hr />
                <a asp-controller="Donations" asp-action="Donate" asp-route-projectId="@Model.Id" class="btn btn-brand-primary w-100 mb-2">Donate Now</a>
                <a asp-controller="Volunteers" asp-action="Register" class="btn btn-outline-secondary w-100">Become a Volunteer</a>
            </div>
        </div>
    </div>
</section>
