<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Gift of the Givers</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var activeNav = ViewData["ActiveNav"] as string ?? "";
    var role = User.IsInRole(UserRoles.Admin) ? "Admin" : User.IsInRole(UserRoles.Employee) ? "Employee" : "Donor";
    var displayName = ViewData["DisplayName"] as string ?? User.Identity?.Name ?? "User";
    var initials = string.Join("", displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper();
}
<div class="dashboard-wrapper">
    <nav class="dashboard-sidebar" id="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-heart-fill" style="color:var(--color-primary-orange);"></i> Gift of the Givers
        </a>

        @if (role == "Donor")
        {
            <a class="nav-link @(activeNav == "dashboard" ? "active" : "")" asp-controller="DonorDashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="nav-link @(activeNav == "donations" ? "active" : "")" asp-controller="DonorDashboard" asp-action="MyDonations"><i class="bi bi-cash-coin"></i> My Donations</a>
            <a class="nav-link @(activeNav == "certificates" ? "active" : "")" asp-controller="DonorDashboard" asp-action="TaxCertificates"><i class="bi bi-file-earmark-text"></i> Tax Certificates</a>
            <a class="nav-link @(activeNav == "profile" ? "active" : "")" asp-controller="DonorDashboard" asp-action="Profile"><i class="bi bi-person-circle"></i> Profile</a>
        }
        else if (role == "Employee")
        {
            <a class="nav-link @(activeNav == "dashboard" ? "active" : "")" asp-controller="EmployeeDashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="nav-link @(activeNav == "projects" ? "active" : "")" asp-controller="EmployeeDashboard" asp-action="Projects"><i class="bi bi-clipboard-data"></i> Projects</a>
            <a class="nav-link @(activeNav == "updates" ? "active" : "")" asp-controller="EmployeeDashboard" asp-action="ProjectUpdates"><i class="bi bi-megaphone"></i> Project Updates</a>
            <a class="nav-link @(activeNav == "volunteers" ? "active" : "")" asp-controller="EmployeeDashboard" asp-action="Volunteers"><i class="bi bi-people"></i> Volunteers</a>
            <a class="nav-link @(activeNav == "donations" ? "active" : "")" asp-controller="EmployeeDashboard" asp-action="Donations"><i class="bi bi-cash-coin"></i> Donations</a>
            <a class="nav-link @(activeNav == "certificates" ? "active" : "")" asp-controller="EmployeeDashboard" asp-action="TaxCertificates"><i class="bi bi-file-earmark-text"></i> Tax Certificates</a>
            <a class="nav-link @(activeNav == "reports" ? "active" : "")" asp-controller="EmployeeDashboard" asp-action="Reports"><i class="bi bi-graph-up"></i> Reports</a>
        }
        else
        {
            <a class="nav-link @(activeNav == "dashboard" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="nav-link @(activeNav == "users" ? "active" : "")" asp-controller="AdminDashboard" asp-action="UserManagement"><i class="bi bi-people-fill"></i> User Management</a>
            <a class="nav-link @(activeNav == "projects" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Projects"><i class="bi bi-clipboard-data"></i> Projects</a>
            <a class="nav-link @(activeNav == "donations" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Donations"><i class="bi bi-cash-coin"></i> Donations</a>
            <a class="nav-link @(activeNav == "volunteers" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Volunteers"><i class="bi bi-people"></i> Volunteers</a>
            <a class="nav-link @(activeNav == "settings" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Settings"><i class="bi bi-gear"></i> Settings</a>
        }

        <hr />
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start"><i class="bi bi-box-arrow-right"></i> Logout</button>
        </form>
    </nav>

    <div class="dashboard-main">
        <div class="dashboard-topbar">
            <button class="btn btn-outline-secondary d-md-none" onclick="document.getElementById('sidebar').classList.toggle('show')">
                <i class="bi bi-list"></i>
            </button>
            <h4 class="mb-0 heading-font">@ViewData["Title"]</h4>
            <div class="d-flex align-items-center gap-2">
                <span class="avatar-circle">@initials</span>
                <span class="fw-semibold d-none d-sm-inline">@displayName</span>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
