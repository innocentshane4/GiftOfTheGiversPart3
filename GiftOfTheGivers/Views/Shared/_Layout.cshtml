<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Gift of the Givers</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar navbar-expand-lg navbar-brand-site sticky-top py-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-heart-fill text-danger" style="color:var(--color-primary-orange)!important;"></i>
                Gift of the Givers
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">

                <!-- LEFT: main site pages -->
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home"      asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home"      asp-action="About">About Us</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Projects"  asp-action="Index">Relief Projects</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Volunteers" asp-action="Register">Volunteer</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Donations" asp-action="Donate">Donate</a></li>
                </ul>

                <!-- RIGHT: auth links grouped together -->
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var role = User.IsInRole(UserRoles.Admin) ? "Admin" : User.IsInRole(UserRoles.Employee) ? "Employee" : "Donor";
                        var dashboardController = role switch
                        {
                            "Admin"    => "AdminDashboard",
                            "Employee" => "EmployeeDashboard",
                            _          => "DonorDashboard"
                        };
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="@dashboardController" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> My Dashboard
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Register">Sign Up</a>
                    }
                    <a class="btn btn-brand-primary btn-sm" asp-controller="Donations" asp-action="Donate">Donate Now</a>
                </div>

            </div>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer mt-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-4">
                    <h6><i class="bi bi-heart-fill" style="color:var(--color-primary-orange);"></i> Gift of the Givers</h6>
                    <p class="small">A humanitarian disaster-relief organisation restoring hope and rebuilding lives across affected communities.</p>
                    <div class="mt-3">
                        <span class="social-icon"><i class="bi bi-facebook"></i></span>
                        <span class="social-icon"><i class="bi bi-twitter-x"></i></span>
                        <span class="social-icon"><i class="bi bi-instagram"></i></span>
                        <span class="social-icon"><i class="bi bi-linkedin"></i></span>
                    </div>
                </div>
                <div class="col-md-2">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Home"      asp-action="About">About Us</a></li>
                        <li><a asp-controller="Projects"  asp-action="Index">Relief Projects</a></li>
                        <li><a asp-controller="Volunteers" asp-action="Register">Volunteer</a></li>
                        <li><a asp-controller="Donations" asp-action="Donate">Donate</a></li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6>Account</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Account" asp-action="Login">Login</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Sign Up</a></li>
                        <li><a href="/admin/login">Staff Login</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6>Stay Informed</h6>
                    <p class="small">Sign up for updates on our relief efforts.</p>
                    <form class="d-flex gap-2">
                        <input type="email" class="form-control form-control-sm" placeholder="Your email address" />
                        <button type="submit" class="btn btn-brand-primary btn-sm">Sign Up</button>
                    </form>
                    <p class="small mt-3 mb-0"><i class="bi bi-geo-alt"></i> 123 Relief Avenue, Johannesburg, South Africa</p>
                    <p class="small"><i class="bi bi-envelope"></i> info@giftofthegivers.org</p>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <p class="small text-center mb-0">&copy; @DateTime.Now.Year Gift of the Givers. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
