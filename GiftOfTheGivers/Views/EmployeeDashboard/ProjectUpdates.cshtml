@model List<ProjectUpdate>
@{
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted-custom mb-0">Post and review updates for active relief projects.</p>
    <a asp-controller="EmployeeDashboard" asp-action="CreateProjectUpdate" class="btn btn-brand-primary btn-sm"><i class="bi bi-plus-lg"></i> Post Update</a>
</div>

<div class="card-brand p-0">
    <div class="table-responsive-cards">
        <table class="table table-brand mb-0">
            <thead><tr><th>Project</th><th>Title</th><th>Date</th><th>Employee</th></tr></thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.ReliefProject?.Name</td>
                        <td>@u.Title</td>
                        <td>@u.PostedDate.ToString("dd MMM yyyy")</td>
                        <td>@(u.Employee?.User?.FullName ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
