@model AdminLoginViewModel
@{
    ViewData["Title"] = "Administrator Access";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Administrator Access — Gift of the Givers</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-login-page">
        <div class="admin-login-card">
            <i class="bi bi-heart-fill" style="color:var(--color-primary-orange); font-size:2rem;"></i>
            <h3 class="mt-2 mb-1">Administrator Access</h3>
            <p class="text-muted-custom small mb-4">Gift of the Givers — internal management portal</p>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger text-start" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <form asp-controller="AdminAccount" asp-action="Login" method="post" class="text-start">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Admin username or email</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-brand-blue w-100 mb-3">Login</button>
            </form>

            <div class="alert alert-light small text-start" style="background-color:var(--color-light-blue); border:none;">
                Administrator accounts are internally provisioned and cannot be created through public registration.
            </div>

            <a asp-controller="Account" asp-action="Login" class="small d-block mt-2">
                <i class="bi bi-arrow-left"></i> Back to User Login
            </a>

            <p class="text-center small text-muted-custom mt-4 mb-0">
                Demo credentials: <code>admin@giftofthegivers.org</code> / <code>Admin@12345</code>
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
